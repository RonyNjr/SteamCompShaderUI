{
  "name": "steam-shaders",
  "version": "0.2.1",
  "description": "Offline Steam shader compilation progress for Decky Loader and Linux desktops",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "python3 scripts/bundle_backend.py && python3 scripts/bundle_licenses.py && rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "node tests/frontend/decky.test.mjs",
    "package": "python3 scripts/package_decky.py"
  },
  "repository": {"type": "git", "url": "https://github.com/RonyNjr/SteamCompShaderUI.git"},
  "author": "RonyNjr",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.5",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "^2.7.0"
  },
  "pnpm": {"peerDependencyRules": {"ignoreMissing": ["react", "react-dom"]}}
}
